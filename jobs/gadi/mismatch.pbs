#!/bin/bash
#PBS -N tss_mp
#PBS -q normal
#PBS -l ncpus=16,mem=64GB,walltime=24:00:00
#PBS -j oe
# Bowtie2 mismatch penalties 8, 6, 4, 2. One sample per array index.
set -euo pipefail
cd "${PBS_O_WORKDIR}"
export TSS_CONFIG="${TSS_CONFIG:-${PBS_O_WORKDIR}/config/gadi.local.yaml}"
cohort="${TSS_COHORT:-hmp2}"
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
  python -m tssbias mismatch-penalty --cohort "${cohort}" --sample-index "$((PBS_ARRAY_INDEX - 1))"
else
  python -m tssbias mismatch-penalty --cohort "${cohort}"
fi
