#PBS -l nodes=1:ppn=64
#PBS -l mem=128gb
#PBS -l walltime=24:00:00
#PBS -q cgsd

cd $PBS_O_WORKDIR


while read -r sample_id SRR type; do
	echo "Downloading ${sample_id}..."
	if [ $type == "DNA" ]
	then
		fasterq-dump --threads 64 $SRR -O primary_seq
	else
		SRR1=$(echo $SRR | cut -f1 -d',')
		SRR2=$(echo $SRR | cut -f2 -d',')
		fasterq-dump --threads 64 $SRR1 -O primary_seq
		fasterq-dump --threads 64 $SRR2 -O primary_seq
	fi
done < $idlist
